---
import GallerySection from '../components/GallerySection.astro';
import GuestGallerySection from '../components/GuestGallerySection.astro';
import PhotoUploadSection from '../components/PhotoUploadSection.astro';
import VenueSection from '../components/VenueSection.astro';
import WeddingSection from '../components/WeddingSection.astro';
import WeddingSideNav from '../components/WeddingSideNav.astro';
import Layout from '../layouts/Layout.astro';
import { client } from '../utils/sanity-client';

const query = `*[_type == "weddingPage"][0] {
    title,
    metaTitle,
    metaDescription,
    sections[] {
        _type,
        title,
        subtitle,
        "anchor": anchor.current,
        // Wedding Section fields
        type,
        content,
        image,
        // Venue Section fields
        churchTitle,
        churchMap,
        venueTitle,
        venueMap,
        churchDirectionsUrl,
        venueDirectionsUrl,
        instagramEmbed,
        // Gallery Section fields
        images[] {
            asset->{
                _id,
                url,
                metadata {
                    dimensions
                }
            },
            hotspot
        },
        // Photo Upload Section fields
        description,
        uploadEndpointUrl,
        // Guest Gallery Section fields
        driveEndpointUrl
    }
}`;
let pageData = null;

try {
    pageData = await client.fetch(query);
} catch (error) {
    console.error('Error fetching wedding page data:', error);
}

const sections = pageData?.sections || [];
---

<Layout
    title={pageData?.metaTitle || pageData?.title || "Svatba Goliášovi"}
    description={pageData?.metaDescription}
>
    <main class="relative scroll-smooth">
        <WeddingSideNav
            sections={sections.map((s) => ({
                id: s.anchor,
                label: s.title,
            }))}
        />

        {
            sections.map((section, index) => {
                const align = index === 1 ? "right" : "left";

                if (section._type === "weddingSection") {
                    return (
                        <WeddingSection
                            id={section.anchor}
                            title={section.title}
                            subtitle={section.subtitle}
                            type={section.type}
                            align={align}
                            content={section.content}
                            image={section.image}
                            instagramEmbed={section.instagramEmbed}
                        />
                    );
                }
                if (section._type === "venueSection") {
                    return (
                        <VenueSection
                            id={section.anchor}
                            title={section.title}
                            subtitle={section.subtitle}
                            churchTitle={section.churchTitle}
                            churchMap={section.churchMap}
                            venueTitle={section.venueTitle}
                            venueMap={section.venueMap}
                            churchDirectionsUrl={section.churchDirectionsUrl}
                            venueDirectionsUrl={section.venueDirectionsUrl}
                        />
                    );
                }
                if (section._type === "gallerySection") {
                    return (
                        <GallerySection
                            id={section.anchor}
                            title={section.title}
                            subtitle={section.subtitle}
                            images={section.images}
                        />
                    );
                }
                if (section._type === "photoUploadSection") {
                    return (
                        <PhotoUploadSection
                            id={section.anchor}
                            title={section.title}
                            subtitle={section.subtitle}
                            description={section.description}
                            uploadEndpointUrl={section.uploadEndpointUrl}
                        />
                    );
                }
                if (section._type === "guestGallerySection") {
                    return (
                        <GuestGallerySection
                            id={section.anchor}
                            title={section.title}
                            subtitle={section.subtitle}
                            driveEndpointUrl={section.driveEndpointUrl}
                        />
                    );
                }
                return null;
            })
        }
    </main>
</Layout>
