---
import { PortableText } from 'astro-portabletext';
import { urlForImage } from '../utils/sanity-client';

interface Props {
    id: string;
    title: string;
    subtitle?: string;
    type: 'story' | 'ceremony' | 'celebration' | 'other';
    // biome-ignore lint/suspicious/noExplicitAny: Sanity content block is not fully typed
    content: any;
    // biome-ignore lint/suspicious/noExplicitAny: Sanity image is not fully typed
    image?: any;
    instagramEmbed?: string;
    schedule?: { time: string; description: string }[];
    greetingUrl?: string;
    mapEmbed?: string;
    align?: 'left' | 'right';
}

const { id, title, subtitle, type, content, schedule, greetingUrl, mapEmbed, image, instagramEmbed, align = 'left' } = Astro.props;

const imageSrc = image ? (typeof image === 'string' ? image : urlForImage(image).url()) : null;

const defaultSubtitle = type === 'story' ? 'Příběh naší lásky' : type === 'ceremony' ? 'Slavnostní okamžik' : 'Veselí a oslava';
---

<section
    id={id}
    class="wedding-section py-20 px-6 md:px-12 flex items-center justify-center relative overflow-hidden bg-base-100 text-base-content"
>
    <!-- Parallax/Transparency Overlay -->
    <div
        class="absolute inset-0 z-0 pointer-events-none bg-base-100 opacity-60 backdrop-blur-3xl"
    >
    </div>
    <div
        class="absolute inset-0 z-0 pointer-events-none opacity-20 bg-linear-to-b from-transparent via-primary/5 to-transparent"
    >
    </div>

    <div
        class="max-w-6xl w-full mx-auto relative z-10 transition-all duration-1000 transform translate-y-12 opacity-0 reveal-container"
    >
        <div
            class={instagramEmbed || imageSrc
                ? `grid md:grid-cols-2 gap-12 lg:gap-24 ${instagramEmbed ? "items-start" : "items-center"} ${align === "right" ? "md:grid-flow-dense" : ""}`
                : "max-w-3xl mx-auto text-center"}
        >
            <div
                class={`space-y-8 ${instagramEmbed || imageSrc ? (align === "right" ? "md:col-start-2 text-right md:text-left" : "") : ""}`}
            >
                <div class="space-y-2 reveal-item-1">
                    <span
                        class="font-['Dancing_Script'] text-2xl md:text-3xl text-primary block mb-2"
                    >
                        {subtitle || defaultSubtitle}
                    </span>
                    <h2
                        class="text-5xl md:text-6xl lg:text-7xl font-['Playfair_Display'] font-black leading-tight"
                    >
                        {title}
                    </h2>
                </div>

                <div
                    class={`prose prose-xl prose-p:text-base-content/80 prose-headings:font-['Playfair_Display'] reveal-item-2 ${!(instagramEmbed || imageSrc) ? "mx-auto" : ""}`}
                >
                    <PortableText value={content} />

                    {
                        schedule && schedule.length > 0 && (
                            <div class="my-10 overflow-hidden rounded-3xl border border-base-content/10 bg-base-100/50 backdrop-blur-md shadow-2xl max-w-2xl w-full mx-auto">
                                <table class="w-full text-left border-collapse m-0">
                                    <tbody>
                                        {schedule.map(({ time, description }) => (
                                            <tr class="border-b border-base-content/10 last:border-b-0 hover:bg-base-content/5 transition-colors duration-300">
                                                <td class="py-5 px-6 w-28 md:w-36 align-middle border-0">
                                                    <span class="inline-flex items-center justify-center px-4 py-1.5 rounded-full bg-base-content/10 text-base-content font-['Playfair_Display'] font-black text-base md:text-lg tracking-wider shadow-inner whitespace-nowrap">
                                                        {time}
                                                    </span>
                                                </td>
                                                <td class="py-5 pr-6 text-base-content/90 font-semibold text-base md:text-lg align-middle leading-relaxed border-0 m-0">
                                                    {description}
                                                </td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        )
                    }

                    {
                        mapEmbed && (
                            <div class="mt-10 w-full reveal-item-2">
                                <div
                                    class="aspect-video w-full rounded-3xl overflow-hidden shadow-xl border-4 border-base-content/10 map-container"
                                    set:html={mapEmbed}
                                />
                            </div>
                        )
                    }

                    {
                        greetingUrl && (
                            <div class="mt-8 flex justify-center w-full">
                                <a
                                    href={greetingUrl}
                                    target="_blank"
                                    class="btn btn-outline btn-primary btn-lg rounded-full px-8 shadow-lg hover:shadow-primary/10 transition-all font-['Playfair_Display'] font-bold w-full sm:w-auto text-center inline-flex items-center justify-center"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="w-6 h-6 mr-2"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <circle cx="12" cy="12" r="10" />
                                        <path d="M16 12l-4-4-4 4M12 8v8" />
                                    </svg>
                                    Sraz a přivítání hostů
                                </a>
                            </div>
                        )
                    }
                </div>
            </div>

            {
                instagramEmbed ? (
                    <div
                        class={`flex justify-center reveal-item-3 ${align === "right" ? "md:col-start-1" : ""}`}
                    >
                        <div
                            class="max-w-full w-full"
                            set:html={instagramEmbed}
                        />
                    </div>
                ) : (
                    imageSrc && (
                        <div
                            class={`relative aspect-[4/5] md:aspect-[1/1] w-full rounded-[60px] overflow-hidden shadow-2xl reveal-item-3 ${align === "right" ? "md:col-start-1" : ""}`}
                        >
                            <div class="absolute inset-0 bg-primary/5 mix-blend-multiply z-10 pointer-events-none" />
                            <img
                                src={imageSrc}
                                alt={title}
                                class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
                                loading="lazy"
                            />
                        </div>
                    )
                )
            }
        </div>
    </div>
</section>

<script>
    const observerOptions = {
        threshold: 0.15,
        rootMargin: "0px",
    };

    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const container =
                    entry.target.querySelector(".reveal-container");
                container?.classList.remove("translate-y-12", "opacity-0");
                container?.classList.add("translate-y-0", "opacity-100");

                // Trigger sub-items
                entry.target
                    .querySelectorAll('[class*="reveal-item-"]')
                    .forEach((item, index) => {
                        setTimeout(() => {
                            item.classList.add("active");
                            // Kick Instagram to re-calculate height once visible
                            if (window.instgrm) {
                                window.instgrm.Embeds.process();
                            }
                        }, index * 200);
                    });
            }
        });
    }, observerOptions);

    document.querySelectorAll(".wedding-section").forEach((section) => {
        revealObserver.observe(section);
    });
</script>

<style>
    .reveal-item-1,
    .reveal-item-2,
    .reveal-item-3 {
        opacity: 0;
        transform: translateY(30px);
        transition: all 1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal-item-1.active,
    .reveal-item-2.active,
    .reveal-item-3.active {
        opacity: 1;
        transform: translateY(0);
    }

    /* Prevent any global iframe styles from breaking Instagram's internal height calculation */
    .wedding-section :global(iframe.instagram-media) {
        position: relative !important;
        height: auto !important;
        min-height: 500px;
    }

    /* Ensure the blockquote doesn't have weird margins that collapse */
    .wedding-section :global(blockquote.instagram-media) {
        margin: 0 auto !important;
        min-height: 500px;
    }

    /* Style for map iframes to be responsive */
    .wedding-section :global(.map-container iframe) {
        width: 100% !important;
        height: 100% !important;
    }
</style>
