---
const sections = [
    { id: "story", label: "Náš příběh" },
    { id: "ceremony", label: "Obřad" },
    { id: "celebration", label: "Oslava" },
    { id: "program", label: "Program" },
    { id: "gifts", label: "Tipy na dárky" },
];
---

<nav class="fixed right-4 top-1/2 -translate-y-1/2 z-50 hidden md:block">
    <ul class="flex flex-col gap-4 items-end">
        {
            sections.map((section) => (
                <li>
                    <a
                        href={`#${section.id}`}
                        class="group flex items-center gap-4 text-base-content/60 hover:text-primary transition-all duration-300"
                        aria-label={section.label}
                    >
                        <span class="text-[10px] uppercase tracking-[0.2em] font-bold opacity-40 group-hover:opacity-100 transition-all duration-300 pointer-events-none translate-x-1 group-hover:translate-x-0">
                            {section.label}
                        </span>
                        <div class="w-2 h-2 rounded-full bg-current border border-current/10 group-hover:scale-150 transition-all duration-300 shadow-sm" />
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<script>
    // Simple scroll spy implementation
    const observerOptions = {
        root: null,
        rootMargin: "-50% 0px",
        threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const id = entry.target.id;
                document.querySelectorAll("nav a").forEach((link) => {
                    const dot = link.querySelector("div");
                    const text = link.querySelector("span");

                    if (link.getAttribute("href") === `#${id}`) {
                        link.classList.add("text-primary");
                        link.classList.remove("text-base-content/60");
                        dot?.classList.add("bg-primary", "scale-150");
                        text?.classList.remove("opacity-40", "translate-x-1");
                        text?.classList.add("opacity-100", "translate-x-0");
                    } else {
                        link.classList.remove("text-primary");
                        link.classList.add("text-base-content/60");
                        dot?.classList.remove("bg-primary", "scale-150");
                        text?.classList.add("opacity-40", "translate-x-1");
                        text?.classList.remove("opacity-100", "translate-x-0");
                    }
                });
            }
        });
    }, observerOptions);

    document.querySelectorAll("section[id]").forEach((section) => {
        observer.observe(section);
    });
</script>
